{
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "ignoreCommand": "bash -c 'if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else exit 0; fi'",
  "crons": [
    {
      "path": "/api/cron/saved-search-alerts",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/ddf-sync",
      "schedule": "0 13 * * *"
    }
  ]
}
