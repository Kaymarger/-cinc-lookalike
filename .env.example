# Copy to .env.local for local runs. Set the same keys in the Vercel project.
# Leave a group blank and that feature stays off. Do not commit real values.
# Full click-by-click setup: SETUP.md

# --- Agent office sign-in. Required. If AGENT_PASSWORD is empty, /agent stays locked. ---
# AGENT_PASSWORD="a long password you choose"
# AUTH_SECRET="optional random string that signs the login cookie"
# If AUTH_SECRET is empty, the cookie is signed with a value derived from AGENT_PASSWORD.

# --- Lead database (one connection string) ---
# Vercel Postgres / Neon: attach the integration and use the POSTGRES_URL it injects.
# Supabase: Database → Connection string → URI, Session pooler (port 5432) or Transaction pooler (port 6543).
# The app creates the captured_leads table on first use. db/schema.sql is the same statement.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# POSTGRES_URL is used when DATABASE_URL is empty.
# POSTGRES_PRISMA_URL is a last-resort fallback.

# --- Agent who receives new-lead alerts ---
# AGENT_ALERT_NAME="Casey Archibald"
# AGENT_ALERT_EMAIL="agent@yourdomain.com"
# AGENT_ALERT_PHONE="+16043637858"

# --- Email (Resend is used when both Resend keys are set; otherwise SendGrid) ---
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="leads@yourdomain.com"
# SENDGRID_API_KEY="SG...."
# SENDGRID_FROM_EMAIL="leads@yourdomain.com"
# LEAD_ALERT_FROM_EMAIL="leads@yourdomain.com"

# --- SMS (Twilio). Skipped unless all three are set along with AGENT_ALERT_PHONE. ---
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM_NUMBER="+16045550100"

# --- Optional ad tags. Pages load normally when these are empty. ---
# META_PIXEL_ID="123456789012345"
# GOOGLE_ADS_ID="AW-123456789"
# GOOGLE_ADS_CONVERSION_LABEL="AbCdEfGhIj"
# NEXT_PUBLIC_SITE_URL="https://cinc-lookalike.vercel.app"

